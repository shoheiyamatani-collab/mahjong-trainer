{
  "name": "mahjong-trainer-workspace",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm build:web && pnpm build:mleague && node scripts/merge-mleague-output.mjs",
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @mahjong-trainer/web dev",
    "dev:mleague": "pnpm --filter @mahjong-trainer/mleague dev",
    "tenhou:parse": "pnpm --filter @mahjong-trainer/tenhou-analysis cli parse",
    "tenhou:inspect": "pnpm --filter @mahjong-trainer/tenhou-analysis cli inspect",
    "tenhou:generate": "pnpm --filter @mahjong-trainer/tenhou-analysis cli generate",
    "tenhou:review": "pnpm --filter @mahjong-trainer/tenhou-analysis cli review",
    "tenhou:fixtures": "pnpm --filter @mahjong-trainer/tenhou-analysis cli fixtures",
    "tenhou:requested": "pnpm --filter @mahjong-trainer/tenhou-analysis cli requested",
    "tenhou:curate": "pnpm --filter @mahjong-trainer/tenhou-analysis cli curate",
    "tenhou:publish": "pnpm --filter @mahjong-trainer/tenhou-analysis cli publish",
    "build:web": "pnpm --filter @mahjong-trainer/web build",
    "build:mleague": "pnpm --filter @mahjong-trainer/mleague build",
    "generate:shorts": "pnpm --filter @mahjong-trainer/shorts-generator generate",
    "generate:shorts:daily": "pnpm generate:shorts --type daily",
    "generate:shorts:voice": "pnpm --filter @mahjong-trainer/shorts-generator voice",
    "test": "pnpm --filter @mahjong-trainer/mahjong-core test",
    "test:tenhou": "pnpm --filter @mahjong-trainer/tenhou-analysis test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
